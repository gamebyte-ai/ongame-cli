{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          { "type": "command", "command": "${CLAUDE_PLUGIN_ROOT}/bin/ongame-launcher", "args": ["hook", "browser-check"], "timeout": 10 }
        ]
      },
      {
        "matcher": "startup|resume|compact",
        "hooks": [
          { "type": "command", "command": "${CLAUDE_PLUGIN_ROOT}/bin/ongame-launcher", "args": ["hook", "build-inject"], "timeout": 10 }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit|.*assets_materialize",
        "hooks": [
          { "type": "command", "command": "${CLAUDE_PLUGIN_ROOT}/bin/ongame-launcher", "args": ["hook", "phase-jury"], "timeout": 45 }
        ]
      },
      {
        "matcher": "mcp__plugin_ongame_ongame__state_init",
        "hooks": [
          { "type": "command", "command": "${CLAUDE_PLUGIN_ROOT}/bin/ongame-launcher", "args": ["hook", "build-marker-write"], "timeout": 10 }
        ]
      },
      {
        "matcher": "mcp__plugin_ongame_ongame__trace_emit",
        "hooks": [
          { "type": "command", "command": "${CLAUDE_PLUGIN_ROOT}/bin/ongame-launcher", "args": ["hook", "build-marker-clear"], "timeout": 10 }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          { "type": "command", "command": "${CLAUDE_PLUGIN_ROOT}/bin/ongame-launcher", "args": ["hook", "build-inject"], "timeout": 10 }
        ]
      }
    ]
  }
}
