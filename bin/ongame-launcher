#!/bin/sh
#
# ongame-launcher — the POSIX twin of `bin/ongame-launcher.exe` (a small C trampoline), and the ONLY file Claude
# Code's plugin.json ever points at. One command string serves every platform: the manifest names
# `${CLAUDE_PLUGIN_ROOT}/bin/ongame-launcher`, and on Windows an extensionless spawn path resolves to its `.exe`
# sibling (MEASURED under both Node's spawn and cross-spawn, even with this sh script sitting right beside it).
#
# This file is a TRAMPOLINE and nothing else. All real version churn — new tools, bugfixes, the backend proxy, and
# as of the Windows work SELF-UPDATE ITSELF — lives in `${ONGAME_INSTALL_DIR:-$HOME/.ongame}/bin/ongame-cli`, the
# compiled binary this script execs into. That split is what makes "no manual `/plugin marketplace update`, ever"
# true: Claude Code only re-reads plugin.json on session start, so plugin.json (and this file) must basically
# never need a bump, while the actual CLI can update on every launch.
#
# Job, in order:
#   1. If the binary does not exist, this is a fresh machine that never ran install.sh — print the exact install
#      command and exit non-zero. We do NOT bootstrap a first install from here (that stays install.sh's job,
#      which also wires PATH/shell-rc/other agentic tools).
#   2. exec into it. POSIX sh's `exec` is a TRUE process-image replacement — stdio and the pid carry over for
#      free, so the JSON-RPC stdio protocol passes through transparently and Claude Code sees no difference from
#      talking to the real binary directly.
#
# WHY SELF-UPDATE IS NO LONGER HERE (it was, until the Windows x64 work): the Windows twin is a ~10KB C
# trampoline with no curl, no sh and no sha256, and Claude Code does not even register the Bash tool on a Windows
# box without Git for Windows — so keeping the updater in shell would have meant writing it a SECOND time in C or
# PowerShell and maintaining two implementations of the one operation that can brick a user's install. It now
# lives in `cli/src/updater.ts`, compiled into the binary that already ships to every platform, and runs at the
# top of `ongame-cli mcp` (the cold-start path only). Every hard-won lesson from the sh version — the separate
# metadata/asset timeouts, URL construction instead of parsing the `assets` array, basename-matched checksums,
# the CHECKED chmod, swallowing every failure to stderr — was carried over verbatim and is now covered by real
# unit tests in `cli/test/updater.test.ts` instead of a bash harness.
#
# Deliberately dependency-free: sh and nothing else. No curl, no node, no npm install, no lockfile — verified
# against a bare-PATH sandbox, since stock macOS guarantees `/bin/sh` and very little else.

set -u

INSTALL_DIR="${ONGAME_INSTALL_DIR:-${HOME:-}/.ongame}"
BIN_PATH="${INSTALL_DIR}/bin/ongame-cli"
INSTALL_SH_URL="https://cli.ongame.ai/install.sh"

# stdout is the JSON-RPC channel once we exec into the real CLI — everything from THIS script must go to stderr
# so it can never be mistaken for a protocol frame.
if [ -z "${ONGAME_INSTALL_DIR:-}" ] && [ -z "${HOME:-}" ]; then
  printf '[ongame-launcher] neither ONGAME_INSTALL_DIR nor HOME is set — cannot locate ~/.ongame. This is unusual; check how this process was spawned.\n' >&2
  exit 1
fi

if [ ! -x "$BIN_PATH" ]; then
  printf '[ongame-launcher] ongame-cli is not installed.\n' >&2
  printf '[ongame-launcher] Run this to install it:  curl -fsSL %s | sh\n' "$INSTALL_SH_URL" >&2
  exit 1
fi

exec "$BIN_PATH" "$@"
